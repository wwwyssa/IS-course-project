@startuml
title ИС «Санаторий для животных» — развёртывание
top to bottom direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam nodeStyle rectangle
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 55
skinparam ArrowColor #526175
skinparam nodeBackgroundColor #F5F7FA
skinparam artifactBackgroundColor #FFFFFF
skinparam databaseBackgroundColor #EAF2F8
hide stereotype

node "Устройство пользователя" as client <<device>> #E8F4ED {
  node "Веб-браузер" as browser <<executionEnvironment>> {
    artifact "React SPA" as frontend
  }
}

node "Сервер приложения" as helios <<device>> {
  node "Веб-сервер\nnginx" as nginx <<executionEnvironment>> #E8F4ED 

  package "Микросервисы · отдельные Java-процессы" as services {
    together {
      node "JVM · Auth Service" as authNode <<executionEnvironment>> {
        artifact "auth-service.jar" as authJar
      }
      node "JVM · Booking Service" as bookingNode <<executionEnvironment>> {
        artifact "booking-service.jar\nвключая State Machine" as bookingJar #FFF3D6
      }
      node "JVM · Payment Service" as paymentNode <<executionEnvironment>> {
        artifact "payment-service.jar" as paymentJar
      }
      node "JVM · Medical Service" as medicalNode <<executionEnvironment>> {
        artifact "medical-service.jar" as medicalJar
      }
    }
  }

  node "PostgreSQL · один экземпляр" as dbNode <<executionEnvironment>> #EAF2F8 {
    together {
      database "auth_db" as dbAuth
      database "booking_db" as dbBooking
      database "payment_db" as dbPayment
      database "medical_db" as dbMedical
    }
  }

  node "SeaweedFS\nОтдельный процесс · S3 API" as storage <<executionEnvironment>> #EAF2F8 {
    storage "Постоянные данные SeaweedFS\nОбъекты и служебные метаданные" as objectData
  }
  node "Consul Agent (server)\nРеестр сервисов" as consul <<executionEnvironment>> #EAF2F8
}

package "Внешняя инфраструктура" as external {
  node "Telegram" as telegramHost <<external>> #F0EAF8 {
    node "Telegram Login\nOpenID Connect" as telegramLogin <<executionEnvironment>>
  }
  node "Платёжный провайдер" as paymentHost <<external>> #F0EAF8 {
    node "API и платёжная страница" as paymentGateway <<executionEnvironment>>
  }
}

browser -down-> nginx : HTTP · SPA и API
nginx -down-> authNode : HTTP
nginx -down-> bookingNode : HTTP
nginx -down-> paymentNode : HTTP
nginx -down-> medicalNode : HTTP

bookingNode -right-> paymentNode : REST · платёж / статус
paymentNode ..> bookingNode : REST · результат

authNode -down-> dbAuth : JDBC / TCP
bookingNode -down-> dbBooking : JDBC / TCP
paymentNode -down-> dbPayment : JDBC / TCP
medicalNode -down-> dbMedical : JDBC / TCP\nМетаданные, bucket и object_key
medicalNode --> storage : S3 API / HTTP\nЗагрузка и получение объектов

' Общая связь заменяет четыре повторяющиеся линии регистрации.
services ..> consul : HTTP API\nРегистрация и поиск

authNode --> telegramLogin : HTTPS / OIDC
paymentNode --> paymentGateway : HTTPS API
paymentGateway ..> nginx : HTTPS webhook

' Фиксация порядка колонок и уровней без видимых линий.
authNode -[hidden]right-> bookingNode
paymentNode -[hidden]right-> medicalNode
dbAuth -[hidden]right-> dbBooking
dbBooking -[hidden]right-> dbPayment
dbPayment -[hidden]right-> dbMedical
dbNode -[hidden]down-> external
@enduml
