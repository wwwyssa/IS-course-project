@startuml
title ИС «Санаторий для животных» — диаграмма компонентов
top to bottom direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #526175
skinparam packageBackgroundColor #F5F7FA
skinparam componentBackgroundColor #FFFFFF
skinparam databaseBackgroundColor #EAF2F8
skinparam NoteBackgroundColor #FFFBEA
hide stereotype

component "Браузер с React\nИнтерфейс пользователя" as frontend #E8F4ED
component "API Gateway\nSpring Cloud Gateway\nHTTPS · React SPA · маршрутизация API" as gateway #E8F4ED


package "Микросервисы · Spring Boot" as backend {
  together {
    component "Auth Service\nВход и пользователи" as authService
    component "Booking Service\nБронирования" as bookingService {
      component "State Machine\nПереходы статусов" as bookingStateMachine #FFF3D6
    }
    component "Payment Service\nПлатежи и статусы" as paymentService
    component "Medical Service\nМедицина и отчёты" as medicalService
  }
}

package "Хранение данных" as data {
  together {
    database "auth_db" as dbAuth
    database "booking_db" as dbBooking
    database "payment_db" as dbPayment
    database "medical_db" as dbMedical
  }
  component "SeaweedFS\nS3-совместимое хранилище\nФото, видео, документы" as storage #EAF2F8
}

package "Внешние системы" as external {
  component "Telegram Login\nOpenID Connect" as telegram #F0EAF8
  component "Платёжный провайдер\nAPI и платёжная страница" as externalPayment #F0EAF8
}
component "Consul\nРеестр сервисов" as consul #EAF2F8

frontend -down-> gateway : HTTPS\nReact SPA и API
gateway -down-> authService : HTTP · /api/auth/
gateway -down-> bookingService : HTTP · /api/bookings/
gateway -down-> paymentService : HTTP · /api/payments/
gateway -down-> medicalService : HTTP · /api/medical/

bookingService -right-> paymentService : Создать платёж / запросить статус
paymentService ..> bookingService : Результат оплаты

authService -down-> dbAuth : JDBC
bookingService -down-> dbBooking : JDBC
paymentService -down-> dbPayment : JDBC
medicalService -down-> dbMedical : JDBC\nМетаданные, bucket и object_key
medicalService --> storage : S3 API / HTTP\nЗагрузка и получение объектов

authService --> telegram : OIDC / HTTPS
paymentService --> externalPayment : HTTPS API
externalPayment ..> gateway : HTTPS webhook\n/api/payments/webhooks
gateway ..> consul : HTTP API\nПоиск адресов сервисов
backend ..> consul : Регистрация и обнаружение

' Невидимые связи фиксируют порядок колонок и уровней.
authService -[hidden]right-> bookingService
paymentService -[hidden]right-> medicalService
dbAuth -[hidden]right-> dbBooking
dbBooking -[hidden]right-> dbPayment
dbPayment -[hidden]right-> dbMedical
data -[hidden]down-> external

@enduml
